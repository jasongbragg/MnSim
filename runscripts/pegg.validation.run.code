source("params.R")
for (f in c("individuals","genetics","mortality","fire","recruitment","census","simulate"))
  source(file.path("R", paste0(f, ".R")))
source("runner/params_utils.R")
source("runner/pegg_validation.R")

# 1. Single run, with figure
result <- run_pegg_validation(get_default_params())

# 2. Seed ensemble -- use a NEW results folder (see note)
df <- run_pegg_seeds(get_default_params(), seeds = 1:100,
                     results_dir = "results/pegg_seeds_fit/",
                     n_cores = parallel::detectCores() - 1L)
plot_pegg_ensemble(df, observed = 0.48,
                   save_path = "results/pegg_seeds_fit/pegg_ensemble.png")



